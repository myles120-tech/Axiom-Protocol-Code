(id==='storm'){ /* cloud banks + lightning */
    for(let k=0;k<3;k++){CX.fillStyle=hexA(def.sky[2],.5-k*.1);
      for(let i=0;i<6;i++){const cx2=wrap(i*210,.18+k*.05),cy=80+k*46;
        CX.beginPath();CX.arc(cx2,cy,34-k*4,0,TAU);CX.arc(cx2+34,cy+6,26-k*3,0,TAU);CX.arc(cx2-30,cy+8,24-k*3,0,TAU);CX.fill();}}
    if((G.t+def.id.length*9)%150<5){const bx=wrap(((G.t*97)%900),0)+200;
      CX.strokeStyle=hexA('#fffbd0',.9);CX.lineWidth=2;CX.beginPath();let by=120,bxx=bx;CX.moveTo(bxx,by);
      for(let s=0;s<5;s++){bxx+=rnd(-26,26);by+=40;CX.lineTo(bxx,by);}CX.stroke();
      flash=4;flashCol='rgba(220,225,255,.22)';}
  } else if(id==='bio'){ /* giant glowing flora */
    for(let i=0;i<6;i++){const sx=wrap(140+i*240,.2),hg=120+((i*61)%150),cap=30+((i*17)%18);
      CX.fillStyle=hexA('#1d7a36',.7);CX.fillRect(sx-5,H-44-hg,10,hg);
      CX.fillStyle=hexA(ed,.5);CX.beginPath();CX.ellipse(sx,H-44-hg,cap,cap*.6,0,Math.PI,0);CX.fill();
      CX.fillStyle=hexA('#caffd6',.5);CX.beginPath();CX.arc(sx,H-44-hg,3,0,TAU);CX.fill();}
  } else if(id==='abyss'){ /* drifting jellyfish + coral */
    for(let i=0;i<5;i++){const jx=wrap(120+i*230,.16),jy=110+Math.sin(G.t*.02+i)*30+((i*40)%120);
      CX.fillStyle=hexA(ed,.28);CX.beginPath();CX.arc(jx,jy,22,Math.PI,0);CX.fill();
      CX.strokeStyle=hexA(ed,.22);CX.lineWidth=2;
      for(let t=-2;t<=2;t++){CX.beginPath();CX.moveTo(jx+t*7,jy);
        CX.quadraticCurveTo(jx+t*7+Math.sin(G.t*.05+t)*6,jy+24,jx+t*7,jy+40);CX.stroke();}}
    CX.fillStyle=hexA('#0a4a6e',.6);for(let i=0;i<6;i++){const cx2=wrap(i*200,.26);
      CX.fillRect(cx2,H-90,8,46);CX.fillRect(cx2+14,H-110,8,66);CX.fillRect(cx2+7,H-74,8,30);}
  } else if(id==='shadow'){ /* void rifts + watching eyes */
    for(let i=0;i<4;i++){const rx=wrap(150+i*250,.2),ry=120+((i*57)%140);
      CX.fillStyle='rgba(0,0,0,.55)';CX.beginPath();CX.ellipse(rx,ry,40,90,0.5,0,TAU);CX.fill();
      CX.strokeStyle=hexA(ed,.4);CX.lineWidth=2;CX.beginPath();CX.ellipse(rx,ry,40,90,0.5,0,TAU);CX.stroke();}
    for(let i=0;i<5;i++){const ex=wrap(90+i*210,.3),ey=100+((i*71)%180),open=Math.sin(G.t*.04+i*2)>-.3;
      if(open){CX.fillStyle=hexA(ed,.8);CX.beginPath();CX.arc(ex,ey,4,0,TAU);CX.arc(ex+12,ey,4,0,TAU);CX.fill();
        CX.fillStyle='#000';CX.beginPath();CX.arc(ex,ey,1.6,0,TAU);CX.arc(ex+12,ey,1.6,0,TAU);CX.fill();}}
  } else if(id==='metal'){ /* rotating gears + smokestacks */
    for(let i=0;i<4;i++){const gx=wrap(160+i*240,.22),gy=120+((i*47)%120),r=26+((i*9)%16),rot=G.t*.01*(i%2?1:-1);
      CX.fillStyle=hexA('#3c4250',.8);for(let tt=0;tt<10;tt++){const a=rot+tt/10*TAU;
        CX.fillRect(gx+Math.cos(a)*r-3,gy+Math.sin(a)*r-3,6,6);}
      CX.beginPath();CX.arc(gx,gy,r-4,0,TAU);CX.fill();
      CX.fillStyle=hexA(ed,.5);CX.beginPath();CX.arc(gx,gy,5,0,TAU);CX.fill();}
    for(let i=0;i<5;i++){const sx=wrap(i*210,.3);CX.fillStyle=hexA('#23262f',.9);CX.fillRect(sx,H-150,26,106);
      CX.globalAlpha=.3;CX.fillStyle='#9aa3b5';for(let p=0;p<3;p++){const yy=H-150-((G.t*.6+p*40)%120);
        CX.beginPath();CX.arc(sx+13,yy,10-p*2,0,TAU);CX.fill();}CX.globalAlpha=1;}
  } else if(id==='sand'){ /* pyramids + dunes + sandstorm wall */
    for(let i=0;i<4;i++){const pxx=wrap(120+i*260,.16),hg=120+((i*53)%120);
      CX.fillStyle=hexA('#8a5a28',.7);CX.beginPath();CX.moveTo(pxx-hg,H-44);CX.lineTo(pxx,H-44-hg);CX.lineTo(pxx+hg,H-44);CX.closePath();CX.fill();
      CX.fillStyle=hexA(ed,.25);CX.beginPath();CX.moveTo(pxx,H-44-hg);CX.lineTo(pxx+hg,H-44);CX.lineTo(pxx+hg*.3,H-44);CX.closePath();CX.fill();}
    CX.fillStyle=hexA('#caa46a',.4);for(let k=0;k<3;k++){CX.beginPath();CX.moveTo(0,H-70+k*12);
      for(let xx=0;xx<=W;xx+=40)CX.quadraticCurveTo(xx+20,H-82+k*12+Math.sin(xx*.01+camx*.002+k)*8,xx+40,H-70+k*12);
      CX.lineTo(W,H);CX.lineTo(0,H);CX.closePath();CX.fill();}
  } else if(id==='core'){ /* glitch code rain */
    CX.fillStyle=hexA(ed,.4);CX.font='10px monospace';
    for(let i=0;i<22;i++){const cx2=wrap(i*60,.25),len=4+((i*7)%6);
      for(let j=0;j<len;j++){const yy=((G.t*2+i*53+j*16)%(H+40))-20;
        CX.globalAlpha=.15+.5*(1-j/len);CX.fillText((i+j+G.t)%2?'1':'0',cx2,yy);}}
    CX.globalAlpha=1;
  }
  CX.restore();
}
function bgAccent(def,camx,mx,my){
  const id=def.id;
  if(id==='magma'){ /* lava glow rising from the bottom */
    const lg=CX.createLinearGradient(0,H-90,0,H);lg.addColorStop(0,'rgba(255,90,20,0)');lg.addColorStop(1,'rgba(255,110,40,.35)');
    CX.fillStyle=lg;CX.fillRect(0,H-90,W,90);}
  else if(id==='cryo'||id==='storm'||id==='shadow'){ /* aurora / energy ribbons */
    CX.globalAlpha=.18;
    for(let k=0;k<3;k++){CX.fillStyle=def.platEdge;CX.beginPath();
      for(let x=0;x<=W;x+=20){const y=120+k*40+Math.sin(x*.01+G.t*.02+k)*30;x===0?CX.moveTo(x,y):CX.lineTo(x,y);}
      CX.lineTo(W,0);CX.lineTo(0,0);CX.fill();}
    CX.globalAlpha=1;}
  else if(id==='abyss'){ /* god-ray light shafts from above */
    CX.globalAlpha=.1;CX.fillStyle=def.platEdge;
    for(let k=0;k<5;k++){const rx=((k*240)-(camx*.2))%(W+240)-120;
      CX.beginPath();CX.moveTo(rx,0);CX.lineTo(rx+40,0);CX.lineTo(rx+120,H);CX.lineTo(rx-40,H);CX.fill();}
    CX.globalAlpha=1;}
  else if(id==='bio'){ /* drifting mist bands */
    CX.globalAlpha=.12;CX.fillStyle=def.platEdge;
    for(let k=0;k<3;k++)CX.fillRect(0,H-160+k*40+Math.sin(G.t*.01+k)*8,W,18);
    CX.globalAlpha=1;}
  else if(id==='metal'){ /* hazy industrial smog + heat shimmer */
    const sg=CX.createLinearGradient(0,0,0,H);sg.addColorStop(0,'rgba(120,130,150,.12)');sg.addColorStop(1,'rgba(60,66,80,.05)');
    CX.fillStyle=sg;CX.fillRect(0,0,W,H);}
  else if(id==='sand'){ /* heat haze + sun blaze */
    const sg=CX.createLinearGradient(0,0,0,H);sg.addColorStop(0,'rgba(240,200,120,.1)');sg.addColorStop(.6,'rgba(200,150,80,.04)');sg.addColorStop(1,'rgba(120,80,40,.08)');
    CX.fillStyle=sg;CX.fillRect(0,0,W,H);}
  else if(id==='core'){ /* glitch scanlines + energy rings */
    CX.globalAlpha=.1;CX.strokeStyle=def.platEdge;CX.lineWidth=2;
    for(let k=0;k<3;k++){CX.beginPath();CX.arc(mx,my,90+k*40+Math.sin(G.t*.04+k)*10,0,TAU);CX.stroke();}
    CX.globalAlpha=1;}
}
function spawnAmbient(def){
  if(G.t%2!==0)return;
  const a=def.amb;
  if(a==='ember')ambP.push({x:rnd(W),y:H+10,vx:rnd(-.4,.4),vy:rnd(-1.8,-.7),l:rnd(60,140),c:'#ff9a4a',s:rnd(1,3),glow:true,fade:true});
  else if(a==='snow')ambP.push({x:rnd(W),y:-10,vx:rnd(-.6,.2),vy:rnd(.6,1.4),l:300,c:'#dff2ff',s:rnd(1,2.5),circ:true});
  else if(a==='rain')ambP.push({x:rnd(W),y:-10,vx:-2,vy:9,l:80,c:'rgba(180,190,255,.6)',s:1,rain:true});
  else if(a==='spore')ambP.push({x:rnd(W),y:rnd(H),vx:rnd(-.3,.3),vy:rnd(-.4,-.1),l:rnd(80,200),c:'#8aff9a',s:rnd(1,2),glow:true,circ:true,fade:true});
  else if(a==='bubble')ambP.push({x:rnd(W),y:H+10,vx:rnd(-.3,.3),vy:rnd(-1.4,-.6),l:rnd(120,240),c:'#9fe6ff',s:rnd(1.5,4),circ:true,glow:true,fade:true});
  else if(a==='void'){if(Math.random()<.7)ambP.push({x:rnd(W),y:rnd(H),vx:rnd(-.5,.5),vy:rnd(-.5,.5),l:rnd(40,90),c:'#a36aff',s:rnd(1,3),glow:true,fade:true});}
  else if(a==='sparks')ambP.push({x:rnd(W),y:H+10,vx:rnd(-1,1),vy:rnd(-3,-1),l:rnd(20,50),c:Math.random()<.5?'#ffb070':'#cdd6e6',s:rnd(1,2),glow:true,fade:true});
  else if(a==='sand')ambP.push({x:-10,y:rnd(H*.3,H),vx:rnd(3,7),vy:rnd(-.5,.5),l:rnd(40,90),c:'rgba(224,176,112,.5)',s:rnd(1,3),fade:true});
  else if(a==='glitch'&&Math.random()<.4)ambP.push({x:rnd(W),y:rnd(H),vx:0,vy:0,l:10,c:'#d24aff',s:rnd(2,14),gl:true});
}
function hexA(hex,a){
  const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${a})`;
}
function mixHex(h1,h2,t){
  const a=[parseInt(h1.slice(1,3),16),parseInt(h1.slice(3,5),16),parseInt(h1.slice(5,7),16)];
  const b=[parseInt(h2.slice(1,3),16),parseInt(h2.slice(3,5),16),parseInt(h2.slice(5,7),16)];
  const m=a.map((v,i)=>Math.round(v+(b[i]-v)*t));
  return '#'+m.map(v=>v.toString(16).padStart(2,'0')).join('');
}
/* ---------- 16-bit tile art (generated per stage, cached) ---------- */
const TILE_STYLE={magma:['cobble','crust'],cryo:['brick','snow'],storm:['panel','rail'],bio:['cobble','grass'],
  abyss:['cobble','coral'],shadow:['crystal','crystal'],metal:['plate','hazard'],sand:['brick','sand'],core:['panel','circuit']};
const tileCache={};
function getTiles(def){
  if(tileCache[def.id])return tileCache[def.id];
  const [bs,cs]=TILE_STYLE[def.id]||['cobble','grass'];
  const base=def.plat, edge=def.platEdge;
  const dk=mixHex(base,'#000000',.55), md=mixHex(base,edge,.28), hi=mixHex(base,edge,.6), sh=mixHex(md,'#000000',.3);
  const R=sRand((def.id.length*131+def.id.charCodeAt(0)*7)|0);
  const mk=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;return c;};
  /* --- body tile (32x32 for stone/brick, 16x16 for panels) --- */
  const N=(bs==='cobble'||bs==='brick')?32:16;
  const body=mk(N,N), b=body.getContext('2d');
  const P=(x,y,w,h,col)=>{b.fillStyle=col;for(const ox of [0,-N])for(const oy of [0,-N])b.fillRect(x+ox,y+oy,w,h);};
  if(bs==='cobble'){
    P(0,0,N,N,dk);
    const rows=[[0,10,[12,9,11]],[10,11,[9,13,10]],[21,11,[11,10,11]]];
    rows.forEach(([ry,rh,ws],r)=>{let x=(r*7)%N;
      for(const w of ws){
        P(x+1,ry+1,w-2,rh-2,md);                                  /* stone body */
        P(x+2,ry,w-4,1,md);P(x+2,ry+rh-1,w-4,1,sh);P(x,ry+2,1,rh-4,md);P(x+w-1,ry+2,1,rh-4,sh);
        P(x+2,ry+1,w-5,1,hi);P(x+1,ry+2,1,rh-5,hi);P(x+2,ry+2,2,1,mixHex(hi,'#ffffff',.3)); /* lit top-left */
        P(x+3,ry+rh-2,w-4,1,sh);P(x+w-2,ry+3,1,rh-5,sh);                                 /* shade */
        P(x+3+((w*7+r)%Math.max(1,w-6)),ry+4+(r%3),2,1,sh);                              /* pit */
        x+=w;}});
    if(def.id==='magma')for(let q=0;q<5;q++)P(R()*N|0,R()*N|0,1,1,'#ff8a3a');
    if(def.id==='abyss')for(let q=0;q<5;q++)P(R()*N|0,R()*N|0,1,1,'#8fe6ff');
    if(def.id==='bio')for(let q=0;q<4;q++){const rx=R()*N|0,ry=R()*N|0;P(rx,ry,1,3,mixHex(edge,'#000000',.45));}
  } else if(bs==='brick'){
    P(0,0,N,N,dk);
    for(let r=0;r<4;r++){const off=r%2?8:0;
      for(let c2=0;c2<2;c2++){const x=off+c2*16;
        P(x+1,r*8+1,15,6,md);P(x+1,r*8+1,14,1,hi);P(x+1,r*8+2,1,4,hi);
        P(x+2,r*8+6,14,1,sh);P(x+15,r*8+2,1,5,sh);
        P(x+4+((r*5+c2*3)%8),r*8+3,2,1,sh)