w(cam);
  drawEshotSpecials();
  player.draw(cam);
  drawShots(cam);
  endActors();
  drawParts(cam);
  cam.x=camX0;
  drawHUD();
  if(player.dead&&player.deadT>40){
    CX.textAlign='center';CX.font='900 30px Orbitron';CX.fillStyle='#ff5d5d';
    CX.shadowColor='#ff5d5d';CX.shadowBlur=18;CX.fillText('UNIT DOWN',W/2,H/2);CX.shadowBlur=0;CX.textAlign='left';}
  if(boss&&boss.phase==='intro'&&boss.introHP<boss.maxHP){
    CX.textAlign='center';CX.font='900 26px Orbitron';
    CX.fillStyle='#fff';CX.shadowColor='#d24aff';CX.shadowBlur=16;
    CX.fillText('WARNING — '+(boss.name||boss.def.boss||'NEXUS PRIME'),W/2,120);CX.shadowBlur=0;CX.textAlign='left';
    if(boss.introHP===1)SFX.warn();
  }
  if(paused)drawPause();
}

/* ---------- main loop ---------- */
function frame(){
  G.t++;
  pollGamepad();
  beginPixelFrame();
  CX.save();
  if(shake>0){CX.translate(rnd(-shake,shake),rnd(-shake,shake));shake*=.86;if(shake<.4)shake=0;}
  if(G.state==='TITLE'){if(MUS.song!=='title'&&AC)playSong('title');updateParts();drawTitle();drawParts({x:0,y:0});}
  else if(G.state==='STORY')drawStory();
  else if(G.state==='CHARSEL'){updateParts();drawCharSel();drawParts({x:0,y:0});}
  else if(G.state==='STAGESEL'){updateParts();drawStageSel();drawParts({x:0,y:0});}
  else if(G.state==='PLAY'){updatePlay();drawPlay();}
  else if(G.state==='GETWEAPON'){updateParts();drawGetWeapon();drawParts({x:0,y:0});}
  else if(G.state==='ENDING'){updateParts();drawEnding();drawParts({x:0,y:0});}
  CX.restore();
  if(flash>0){CX.fillStyle=flashCol;CX.fillRect(0,0,W,H);flash--;}
  presentPixelFrame();
  /* show up/down d-pad only where vertical navigation matters */
  if(document.body&&document.body.classList)
    document.body.classList.toggle('gridnav', G.state==='STAGESEL');
  for(const k in Pressed)Pressed[k]=false;
  requestAnimationFrame(frame);
}
let vigGrad=null;
addEventListener('keydown',()=>{audio();},{once:true});
addEventListener('pointerdown',()=>{audio();},{once:true});
/* ---------- touch controls ---------- */
(function(){
  const isTouch=('ontouchstart' in window)||navigator.maxTouchPoints>0;
  if(!isTouch)return;
  document.body.classList.add('touchmode');
  const press=k=>{if(!Keys[k])Pressed[k]=true;Keys[k]=true;};
  const release=k=>{Keys[k]=false;};
  document.querySelectorAll('.tbtn').forEach(btn=>{
    const k=btn.dataset.k;
    const down=e=>{e.preventDefault();audio();btn.classList.add('active');press(k);};
    const up=e=>{e.preventDefault();btn.classList.remove('active');release(k);};
    btn.addEventListener('touchstart',down,{passive:false});
    btn.addEventListener('touchend',up,{passive:false});
    btn.addEventListener('touchcancel',up,{passive:false});
    /* slide between ◀ and ▶ without lifting the thumb */
    btn.addEventListener('touchmove',e=>{
      if(k!=='L'&&k!=='R')return;e.preventDefault();
      const t=e.touches[0],el=document.elementFromPoint(t.clientX,t.clientY);
      const over=el&&el.dataset?el.dataset.k:null;
      if(over==='L'||over==='R'){
        if(over!==k){release(k);press(over);
          document.getElementById(over==='L'?'bL':'bR').classList.add('active');
          btn.classList.remove('active');}
      }
    },{passive:false});
  });
  /* tapping the screen on menus = confirm */
  CV.addEventListener('touchstart',e=>{e.preventDefault();audio();
    if(G.state==='TITLE'||G.state==='STORY'||G.state==='GETWEAPON'||G.state==='ENDING')Pressed.OK=true;
  },{passive:false});
  /* stop iOS double-tap zoom / scroll */
  document.addEventListener('touchmove',e=>{if(e.target.closest('#touch')||e.target===CV)e.preventDefault();},{passive:false});
  document.addEventListener('gesturestart',e=>e.preventDefault());
  /* orientation: JS-driven so it always releases in landscape and can be skipped */
  let rotateSkipped=false;
  function checkOrient(){
    const portrait=window.innerHeight>window.innerWidth;
    document.body.classList.toggle('show-rotate', portrait && !rotateSkipped);
  }
  document.getElementById('skipRotate').addEventListener('touchstart',e=>{
    e.preventDefault();e.stopPropagation();rotateSkipped=true;audio();checkOrient();
  },{passive:false});
  document.getElementById('skipRotate').addEventListener('click',()=>{rotateSkipped=true;audio();checkOrient();});
  addEventListener('resize',checkOrient);
  addEventListener('orientationchange',()=>setTimeout(checkOrient,200));
  checkOrient();
})();
frame();
</script>
</body>
</html>
